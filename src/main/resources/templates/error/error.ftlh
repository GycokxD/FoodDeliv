<#import "../layout.ftlh" as layout>
<@layout.layout title="Ошибка">
<div class="auth-container text-center">
    <i class="bi bi-exclamation-circle" style="font-size: 3rem; color: #ff6b6b;"></i>
    <h2 class="mt-3">Что-то пошло не так</h2>
    <p class="text-muted">Попробуйте обновить страницу или вернуться на главную.</p>
    <a class="btn btn-primary" href="/">На главную</a>
</div>
</@layout.layout>
