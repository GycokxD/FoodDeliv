<#import "../layout.ftlh" as layout>
<@layout.layout title="Страница не найдена">
<div class="auth-container text-center">
    <i class="bi bi-signpost-2" style="font-size: 3rem; color: #ff6b6b;"></i>
    <h2 class="mt-3">Страница не найдена</h2>
    <p class="text-muted">Такого адреса нет. Вернитесь к ресторанам и выберите блюдо.</p>
    <a class="btn btn-primary" href="/">На главную</a>
</div>
</@layout.layout>
